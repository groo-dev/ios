<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<!-- Required for native passkey sign-in: without it the platform will not
		     look for a credential scoped to me.groo.dev and simply reports that
		     there are none, with nothing naming the cause. The issuer serves the
		     matching apple-app-site-association from the ios client row's
		     bundle_id + apple_team_id. -->
		<string>webcredentials:me.groo.dev</string>
	</array>
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.groo.ios</string>
		<string>group.dev.groo.ios.debug</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.groo.ios</string>
	</array>
</dict>
</plist>
